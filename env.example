# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Email Configuration (SMTP - Titan Email)
SMTP_HOST=smtp.titan.email
SMTP_PORT=587
SMTP_USER=your_email@eastatwest.com
SMTP_PASS=your_email_password
SMTP_FROM_EMAIL=your_email@eastatwest.com

# Google Maps Configuration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_google_maps_map_id_here

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Base URL for webhooks
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Add your actual values to .env.local (this file is ignored by Git) 